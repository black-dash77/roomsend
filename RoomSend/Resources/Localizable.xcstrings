    "send.noRecipient": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody to send to yet. Open RoomSend or LocalSend on another device on this Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne à qui envoyer pour l'instant. Ouvre RoomSend ou LocalSend sur un autre appareil du même Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand zum Senden. Öffne RoomSend oder LocalSend auf einem anderen Gerät im selben WLAN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay a quién enviar. Abre RoomSend o LocalSend en otro dispositivo del mismo Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno a cui inviare. Apri RoomSend o LocalSend su un altro dispositivo della stessa Wi-Fi."
          }
        },
        "pt": {
